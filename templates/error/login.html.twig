{% extends "master.html.twig" %}

{% set title = 'Login Error' %}

{% block content %}
    <div class="error-page">
        <h2 class="headline text-yellow">Error</h2>

        <div class="error-content">
            <h3><i class="fa fa-warning text-yellow"></i> {{ error_code }}</h3>
            <p>{{ error_description }}</p>
            <p>You may attempt to <a href="{{ base_url() }}/login">sign in</a> again.</p>
        </div>
    </div>
{% endblock %}
